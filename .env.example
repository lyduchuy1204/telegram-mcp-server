# Copy to ~/.telegram-mcp/.env (recommended) or ./.env and fill in your own values.
# Never commit the real file.

# Required: create an app at https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: where the login session is stored (default: ~/.telegram-mcp/telegram.session)
# TELEGRAM_SESSION_PATH=~/.telegram-mcp/telegram.session

# Optional: which tools are exposed
#   full      - everything (destructive tools still default to dry_run)
#   safe      - no destructive tools (no delete / leave / revoke)
#   read-only - only tools that read data
# TELEGRAM_MCP_MODE=full

# Optional: country code used when you type a phone number without "+" during login
# TELEGRAM_DEFAULT_COUNTRY_CODE=1
